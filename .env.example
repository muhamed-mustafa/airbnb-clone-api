PORT=3000
NODE_ENV=development

# i18n
FALLBACK_LANGUAGE=en

# db
MONGO_URI=mongodb://localhost:27017/airbnb-clone?replicaSet=rs0

# JWT
JWT_SECRET=
ADMIN_PASSWORD_RESET_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD_RESET_CODE_TTL_MINUTES=10
ADMIN_PASSWORD_RESET_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE_IN=
REFRESH_TOKEN_EXPIRE_IN=


# Admin Seed
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Admin password recovery email (Resend). Both are needed to enable recovery.
RESEND_API_KEY=
AUTH_EMAIL_FROM=


# File Storage
FILE_STORAGE_PROVIDER=cloudinary

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_KEY_PREFIX=airbnb/units
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Stable HTTPS delivery URL (normally CloudFront), not a presigned URL
AWS_S3_BASE_URL=
# Optional, only for temporary environment credentials
AWS_SESSION_TOKEN=
