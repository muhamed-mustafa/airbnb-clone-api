PORT=3000
NODE_ENV=development

# i18n
FALLBACK_LANGUAGE=en

# db
MONGO_URI=mongodb://localhost:27017/airbnb-clone?replicaSet=rs0

# JWT
JWT_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE_IN=
refreshTokenExpireIn=


# Admin Seed
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=


# File Storage
FILE_STORAGE_PROVIDER=cloudinary

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_KEY_PREFIX=airbnb/units
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Stable HTTPS delivery URL (normally CloudFront), not a presigned URL
AWS_S3_BASE_URL=
# Optional, only for temporary environment credentials
AWS_SESSION_TOKEN=
